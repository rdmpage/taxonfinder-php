#!/usr/bin/env php
<?php
/**
 * Command line front end.
 *
 *   bin/taxonfinder paper.txt
 *   cat paper.txt | bin/taxonfinder
 *   bin/taxonfinder --html --tag page.html
 *   bin/taxonfinder --mark paper.txt > paper.html
 */

require __DIR__ . '/../autoload.php';

$options = array('html' => false, 'format' => 'json', 'pretty' => true, 'context' => 32,
                 'carryOver' => false);
$files = array();

foreach (array_slice($argv, 1) as $argument) {
    if (preg_match('/^--context=(\d+)$/', $argument, $match)) {
        $options['context'] = (int) $match[1];
        continue;
    }
    switch ($argument) {
        case '--html': $options['html'] = true; break;
        case '--compact': $options['pretty'] = false; break;
        case '--names': $options['format'] = 'names'; break;
        case '--tag': $options['format'] = 'tag'; break;
        case '--mark': $options['format'] = 'mark'; break;
        case '--carry-over': $options['carryOver'] = true; break;
        case '-h':
        case '--help':
            usage(0);
            break;
        default:
            if (substr($argument, 0, 1) === '-' && $argument !== '-') {
                fwrite(STDERR, "Unknown option: $argument\n");
                usage(1);
            }
            $files[] = $argument;
    }
}

if (!$files) {
    $files[] = 'php://stdin';
}

$finder = new Taxonfinder\Finder(null, $options['context']);
$finder->setCarryOverKeyGenus($options['carryOver']);

foreach ($files as $file) {
    $text = file_get_contents($file === '-' ? 'php://stdin' : $file);
    if ($text === false) {
        fwrite(STDERR, "Could not read $file\n");
        exit(1);
    }
    switch ($options['format']) {
        case 'tag':
            echo $finder->tagText($text, $options['html']);
            break;
        case 'mark':
            echo $finder->markText($text, $options['html']);
            break;
        case 'names':
            foreach ($finder->names($text, $options['html']) as $name) {
                echo $name, "\n";
            }
            break;
        default:
            echo encode($finder->find($text, $options['html']), $options['pretty']), "\n";
    }
}

/** JSON, falling back to substitution if the source text is not valid UTF-8. */
function encode($data, $pretty)
{
    $flags = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
    if ($pretty) {
        $flags |= JSON_PRETTY_PRINT;
    }
    $json = json_encode($data, $flags);
    if ($json === false && defined('JSON_INVALID_UTF8_SUBSTITUTE')) {
        $json = json_encode($data, $flags | JSON_INVALID_UTF8_SUBSTITUTE);
    }
    if ($json === false) {
        fwrite(STDERR, "Could not encode results as JSON: " . json_last_error_msg() . "\n");
        exit(1);
    }
    return $json;
}

function usage($status)
{
    $stream = $status === 0 ? STDOUT : STDERR;
    fwrite($stream, <<<TEXT
Usage: taxonfinder [options] [file ...]

Finds scientific names in text. Reads standard input if no file is given.
Prints a JSON array of annotation records, loosely modelled on the W3C Web
Annotation Data Model: the interpreted name in body.value, the original string
and its surroundings in a TextQuoteSelector, byte offsets in a
TextPositionSelector, and any nomenclatural annotation ('sp. nov.', 'comb.
nov.') under nomenclature.

  --html         the input is HTML, not plain text
  --compact      one line of JSON instead of pretty printed
  --context=N    bytes of context either side of a name (default 32)
  --names        print just the unique names, one per line
  --tag          print the input with every name wrapped in a <name> element
  --mark         print the input as HTML with every name wrapped in <mark>
  --carry-over   read a key's bare epithets under the genus of its heading
  --help         show this message

TEXT
    );
    exit($status);
}
